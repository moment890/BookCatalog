<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BookCatalog.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="BookCatalog.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="BookCatalog">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <StackPanel>
        <StackPanel Margin="0 4 0 20" Orientation="Horizontal" Spacing="11">
            <TextBox Watermark="Search..." Width="600" Text="{Binding SearchText}" />
            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}">
                <ComboBox.ItemTemplate>
					<DataTemplate>
						<TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel Margin="690 -53 0 20" Orientation="Horizontal" Spacing="11">
           <ComboBox ItemsSource="{Binding Genres}" SelectedItem="{Binding Genres}">
                <ComboBox.ItemTemplate>
					<DataTemplate>
						<TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
             <ListBox ItemsSource="{Binding Genres }">
		    <ListBox.ItemTemplate>
			    <DataTemplate>
				    <StackPanel>
					    <TextBlock Text="{Binding Id}" />
					    <TextBlock Text="{Binding Name }" />
                        <TextBlock Text="{Binding }"/> 
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        </StackPanel>

         <ListBox ItemsSource="{Binding Categories }">
		    <ListBox.ItemTemplate>
			    <DataTemplate>
				    <StackPanel>
					    <TextBlock Text="{Binding Id}" />
					    <TextBlock Text="{Binding Name }" />
                        <TextBlock Text="{Binding Books}"/> 
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>

</Window>

